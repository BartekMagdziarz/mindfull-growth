# Copy to .env.ai-companion.local (ignored by Git). Never use a VITE_ prefix.
OPENAI_API_KEY=
# Candidate pending a live benchmark; no fallback to a different model.
AI_COMPANION_MODEL=gpt-6-luna
AI_COMPANION_EFFORT=medium
# Conservative USD estimate across the entire run, not a provider billing cap.
AI_COMPANION_MAX_USD=15
# Default smoke run: Marta, initial topics then selected-topic conversation.
AI_COMPANION_PERSONAS=marta
# Set full for all 3 checkpoints per selected persona + selected-topic followup.
AI_COMPANION_SCOPE=smoke
# Standard short-context upper input rate includes cache writes; verified 2026-09-28.
# Update both rates if changing model. Values are USD per million tokens.
AI_COMPANION_INPUT_RATE=0.125
AI_COMPANION_OUTPUT_RATE=0.5
