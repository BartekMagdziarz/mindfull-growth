{
  "name": "mindfull-growth-ux-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5201 --strictPort",
    "build": "npm run check:boundaries && vue-tsc --noEmit && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "vue-tsc": "^2.1.10"
  }
}
