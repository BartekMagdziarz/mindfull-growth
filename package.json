{
  "name": "mindfull-growth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai-demo": "vite --mode ai-demo --port 5203 --host 127.0.0.1 --strictPort",
    "dev:verify": "vite --mode verification --port 5199 --host 127.0.0.1 --strictPort",
    "dev:demo": "vite --mode demo --port 5205 --host 127.0.0.1 --strictPort",
    "dev:lab": "node scripts/devUxLab.mjs",
    "dev:lab:ui": "npm --prefix ux-lab/app run dev",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:verify": "playwright test --project=verification",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src e2e scripts \"*.{ts,js,mjs}\"",
    "format:check": "prettier --check src e2e scripts \"*.{ts,js,mjs}\"",
    "check-locales": "node scripts/check-locale-keys.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "ai:benchmark": "node scripts/runCompanionBenchmark.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.0.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.32.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.1.10"
  }
}
